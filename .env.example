# ============================================
# DeFi Price Manipulation Analyzer - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# Authentication
# Password for system access (plaintext for dev, or bcrypt hash for production)
# To generate bcrypt hash: node -e "const b=require('bcryptjs');console.log(b.hashSync('YOUR_PASSWORD',10))"
USER_PASSWORD_HASH=admin123

# JWT Secret (change this for production!)
JWT_SECRET=change-me-to-a-random-string-in-production

# Etherscan V2 API Key (unified key for all chains)
# Get one at: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# ---- LLM Configuration (Choose ONE mode) ----

# Option A: Z.ai Platform Mode (default, no config needed)
# - Automatically uses z-ai-web-dev-sdk on Z.ai platform
# - No additional configuration required
# - LLM_MODEL=qwen3.5-plus (optional override)

# Option B: OpenAI-Compatible API Mode (for external deployment)
# - Set OPENAI_API_KEY to enable this mode
# - Supports any OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=        # Optional: custom API endpoint (e.g. https://api.deepseek.com/v1)
LLM_MODEL=gpt-4o-mini   # Model name (gpt-4o-mini, deepseek-chat, etc.)

# ---- OpenCode / Development Tools ----

# ZHIPU API Key (for opencode.ai GLM model access)
# ZHIPU_API_KEY=

# GitHub Token (for MCP github server, optional)
# GITHUB_TOKEN=
