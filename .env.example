# ============================================
# DeFi Price Manipulation Analyzer - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# Authentication
# Password for system access (plaintext for dev, or bcrypt hash for production)
# To generate bcrypt hash: node -e "const b=require('bcryptjs');console.log(b.hashSync('YOUR_PASSWORD',10))"
USER_PASSWORD_HASH=admin123

# JWT Secret (change this for production!)
JWT_SECRET=change-me-to-a-random-string-in-production

# Etherscan V2 API Key (unified key for all chains)
# Get one at: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# ---- LLM Configuration (Dual Provider) ----

# Primary provider (GLM 5.2 for complex tasks)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-5.2

# Fast provider (DeepSeek V4 Flash for simple tasks: report gen, summary)
# Optional: if not configured, all tasks use primary provider
OPENAI_API_KEY_FAST=
OPENAI_BASE_URL_FAST=https://api.deepseek.com
LLM_MODEL_FAST=deepseek-v4-flash

# Medium provider (DeepSeek V4 Pro for moderate tasks: PoC generation, context fallback)
# Optional: if not configured, falls back to primary provider
OPENAI_API_KEY_MEDIUM=
OPENAI_BASE_URL_MEDIUM=https://api.deepseek.com
LLM_MODEL_MEDIUM=deepseek-v4-pro

# Structured output mode for LLM JSON responses (T5)
# Options: 'tool' (function calling), 'json_schema' (response_format), 'markdown' (fence stripping)
# Default: 'markdown' (always works)
LLM_OUTPUT_MODE=markdown

# ---- Database (T6: Prisma + SQLite) ----

# SQLite database file path for Prisma
DATABASE_URL=file:./dev.db
