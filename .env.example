# ============================================
# DeFi Price Manipulation Analyzer - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# Authentication
# Password for system access (plaintext for dev, or bcrypt hash for production)
# To generate bcrypt hash: node -e "const b=require('bcryptjs');console.log(b.hashSync('YOUR_PASSWORD',10))"
USER_PASSWORD_HASH=admin123

# JWT Secret (change this for production!)
JWT_SECRET=change-me-to-a-random-string-in-production

# Etherscan V2 API Key (unified key for all chains)
# Get one at: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# ---- LLM Configuration (DeepSeek V4 Pro via OpenAI-compatible API) ----

# Required: DeepSeek API key
# Get one at: https://platform.deepseek.com/api_keys
OPENAI_API_KEY=

# API endpoint (DeepSeek default)
OPENAI_BASE_URL=https://api.deepseek.com

# Model name
LLM_MODEL=deepseek-chat

# Structured output mode for LLM JSON responses (T5)
# Options: 'tool' (function calling), 'json_schema' (response_format), 'markdown' (fence stripping)
# Default: 'markdown' (always works); 'tool' recommended for DeepSeek V4 Pro
LLM_OUTPUT_MODE=markdown

# ---- Database (T6: Prisma + SQLite) ----

# SQLite database file path for Prisma
DATABASE_URL=file:./dev.db
