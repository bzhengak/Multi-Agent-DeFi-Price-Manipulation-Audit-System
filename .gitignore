# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ============================================
# Environment & Secrets — NEVER commit these!
# ============================================
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*

# ============================================
# Z.ai Platform — not needed for external deployment
# ============================================
.claude
.z-ai-config
.zscripts/
skills/
Caddyfile

# ============================================
# Logs
# ============================================
*.log
dev.log
dev.out.log
server.log

# ============================================
# Runtime data — generated at startup
# ============================================
.storage/
db/
*.sqlite

# ============================================
# Upload & temp directories
# ============================================
/upload/
.temp_decompiled/

# ============================================
# Examples & test files — not needed for deployment
# ============================================
examples/
download/

# ============================================
# Development logs & helper scripts
# ============================================
worklog.md
push-to-github.sh
defi-analyzer.bundle
easy-push.sh
push-via-api.py

# OpenCode 运行时数据
.opencode/session*

